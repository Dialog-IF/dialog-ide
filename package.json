{
  "name": "dialog-ide",
  "displayName": "Dialog IDE",
  "version": "1.0.0",
  "description": "VS Code extension for Dialog interactive fiction development with a Skein engine",
  "publisher": "hlship",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "dialog-ide.openSkein",
        "title": "Dialog IDE: Open Skein"
      },
      {
        "command": "dialog-ide.runDefaultSkein",
        "title": "Dialog IDE: Run Default Skein"
      },
      {
        "command": "dialog-ide.runSkein",
        "title": "Dialog IDE: Run Skein..."
      },
      {
        "command": "dialog-ide.newSkein",
        "title": "Dialog IDE: New Skein..."
      },
      {
        "command": "dialog-ide.stopSkein",
        "title": "Dialog IDE: Stop Skein"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "dialog",
    "interactive-fiction",
    "skein-engine",
    "ide"
  ],
  "author": "Howard Lewis Ship",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.0.0"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "dependencies": {
    "immutable": "^5.1.9"
  }
}
